# 로컬 개발용 — .env.local 로 복사해서 쓴다(.env.local은 저장소에 올라가지 않는다). 빈 값이면 해당 기능은 "준비 중"으로 표시된다.
# 배포 사이트는 이 파일이 아니라 GitHub 저장소 Settings → Secrets and variables → Actions → Variables 값을 쓴다(docs/SUPABASE_SETUP.md).
# ⚠️ NEXT_PUBLIC_* 는 전부 브라우저 번들에 들어가는 공개값이다. 비밀은 절대 넣지 않는다:
#    카카오 REST API 키·Client Secret, Supabase secret(sb_secret_…)·service_role 키, DB 비밀번호, Anthropic API 키,
#    Turnstile 비밀 키 — 이것들은 Supabase 대시보드 또는 GitHub Secrets에만 둔다.

# 사용자 관리·카카오 로그인·서버 저장·영상/AI 프록시(Supabase) — URL과 키 둘 다 채워야 켜진다. 비우면 지금처럼 브라우저에만 저장하는 게스트.
# URL 예: https://movrwmoniopgetdmagon.supabase.co
# PUBLISHABLE_KEY 자리에는 공개 키만: Publishable key(sb_publishable_…) 또는 예전 anon 키. 데이터는 RLS(본인 행만)가 지킨다.
# secret 키(sb_secret_…)·service_role 키를 넣으면 빌드가 멈춘다(src/config.ts).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 카카오 JavaScript 키(공개값) — 가까운 산부인과 지도. 카카오 콘솔 [앱] > [플랫폼 키] > [JavaScript 키]의 JavaScript SDK 도메인에
# http://localhost:3000 을 등록해야 내 컴퓨터에서 지도가 뜬다.
NEXT_PUBLIC_KAKAO_JS_KEY=

# Cloudflare Turnstile 사이트 키(공개값) — Supabase CAPTCHA를 켰을 때만. 비우면 CAPTCHA 없이 게스트(익명 계정)를 만든다.
# 대시보드에서 CAPTCHA를 켰는데 이 값이 비어 있으면 익명 계정을 만들지 못해, 게스트가 서버 계정 없이 이 브라우저 전용으로
# 시작된다(기록이 서버에 올라가지 않음). 켜는 순서: docs/SUPABASE_SETUP.md B-6.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# AI 상담 — "true"일 때만 켜진다. Supabase Edge Function 비밀값 ANTHROPIC_API_KEY와 CPO·법률 승인(docs/LAUNCH_CHECKLIST.md 5)이 먼저다.
NEXT_PUBLIC_AI_CHAT_ENABLED=false

# 매일 리마인더(웹 푸시)의 VAPID 공개 키(공개값) — `node scripts/generate-vapid.mjs`가 출력한 한 쌍 중 **공개 키**만.
# Supabase 설정과 이 값이 둘 다 있어야 설정 > 알림 토글이 켜진다. 비우면 "준비 중". 비밀 키(VAPID_PRIVATE_KEY)는 Supabase 함수 비밀값에만
# (docs/PWA_AND_REMINDERS.md). 형식이 틀리면 빌드가 멈춘다.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# 검색 노출 — "true"면 서비스 소개(/)만 색인 허용, 나머지 화면은 계속 noindex. 기본(비움)은 전부 noindex(1.0 공개 전).
# 서비스 소개 페이지(src/app/page.tsx)가 robotsFor("landing")을 쓰는 빌드에서만 효과가 있다(docs/PWA_AND_REMINDERS.md §8).
NEXT_PUBLIC_SITE_INDEXABLE=false

# 서버 쪽 값(ANTHROPIC_API_KEY·VIDEO_API_URL·ALLOWED_ORIGINS·CHAT_*·VAPID_PRIVATE_KEY·VAPID_SUBJECT·REMINDER_CRON_SECRET)은 이 파일에 넣지 않는다 —
# Supabase 함수 비밀값이고, GitHub의 "Supabase" 워크플로가 넣는다(docs/SUPABASE_SETUP.md C·D, docs/PWA_AND_REMINDERS.md).

# 예전 방식(서버 직접 호출). Supabase를 켠 빌드에서는 영상·AI 상담이 Supabase 함수(videos·chat)를 거친다.
NEXT_PUBLIC_VIDEO_URL=https://hackathon-video-api.onrender.com
NEXT_PUBLIC_LLM_URL=
NEXT_PUBLIC_ACCOUNT_URL=
NEXT_PUBLIC_ONMOM_APP_KEY=

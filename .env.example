# 로컬 개발용 — .env.local 로 복사해서 쓴다. 빈 값이면 해당 기능은 "준비 중"으로 표시된다.
# ⚠️ NEXT_PUBLIC_* 는 전부 브라우저 번들에 들어가는 공개값이다. 비밀(REST 키·client secret·API 키)은 절대 넣지 않는다.
NEXT_PUBLIC_VIDEO_URL=https://hackathon-video-api.onrender.com
NEXT_PUBLIC_LLM_URL=
NEXT_PUBLIC_ACCOUNT_URL=
NEXT_PUBLIC_ONMOM_APP_KEY=
NEXT_PUBLIC_KAKAO_JS_KEY=

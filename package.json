{
  "name": "onmom-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/csp-hash.mjs --check",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "BASE_PATH=/onmom_web NEXT_PUBLIC_SUPABASE_URL= NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY= npm run build && BASE_PATH=/onmom_web playwright test",
    "e2e:run": "playwright test",
    "e2e:server": "E2E_SERVER=1 playwright test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "pretendard": "^1.3.9",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vitest": "^5.0.5"
  }
}
